{
  "name": "@stwd/web",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3202",
    "build": "next build",
    "start": "next start --port ${PORT:-3202}",
    "test": "bun test src",
    "test:unit": "bunx turbo run build --filter=@stwd/shared --filter=@stwd/sdk --filter=@stwd/react && bun test src",
    "e2e": "playwright test",
    "e2e:chromium": "playwright test --project=chromium",
    "e2e:trust-ux": "NEXT_PUBLIC_STEWARD_API_URL=http://127.0.0.1:3299 E2E_ALLOW_INSECURE_HTTP=true bun run build && playwright test --config=playwright.trust.config.ts",
    "e2e:install": "playwright install chromium firefox webkit",
    "cf:build": "node scripts/assert-production-deploy-env.mjs && opennextjs-cloudflare build",
    "cf:preview": "node scripts/assert-production-deploy-env.mjs && opennextjs-cloudflare preview",
    "cf:deploy": "node scripts/assert-production-deploy-env.mjs && opennextjs-cloudflare build && wrangler deploy"
  },
  "dependencies": {
    "@rainbow-me/rainbowkit": "^2.2.10",
    "@simplewebauthn/browser": "^13.3.0",
    "@solana/wallet-adapter-react": "^0.15.39",
    "@solana/wallet-adapter-react-ui": "^0.9.39",
    "@solana/web3.js": "^1.98.0",
    "@stwd/react": "workspace:*",
    "@stwd/sdk": "workspace:*",
    "@stwd/shared": "workspace:*",
    "@tanstack/react-query": "^5.90.21",
    "framer-motion": "^12.36.0",
    "next": "^15.5.16",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "viem": "^2.50.4",
    "wagmi": "^2.19.5",
    "@solana/wallet-adapter-phantom": "^0.9.29",
    "@solana/wallet-adapter-solflare": "^0.6.33",
    "@solana/wallet-adapter-coinbase": "^0.1.23",
    "@solana/wallet-adapter-trust": "^0.1.17",
    "@solana/wallet-adapter-coin98": "^0.5.24"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@opennextjs/cloudflare": "^1.19.11",
    "@playwright/test": "^1.60.0",
    "@types/node": "25.5.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.0",
    "bs58": "^6.0.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.8.0",
    "wrangler": "^4.95.0"
  }
}
