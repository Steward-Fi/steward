# Steward enterprise reference environment template.
#
# DO NOT ship or reuse the placeholder values below as-is. This file exists only
# to document the variable NAMES. The ONLY supported way to produce a usable
# environment is:
#
#   steward init --env deploy/enterprise-reference/.env --force
#
# `steward init` generates distinct admin, migration, and runtime database
# credentials plus fresh secrets for every STEWARD_* key. All secret values below are left
# EMPTY on purpose so that copying this template without running `steward init`
# fails loudly (compose has `${VAR:?required}` guards) instead of silently
# booting with known credentials.
STEWARD_IMAGE_TAG=enterprise-reference
STEWARD_DOMAIN=steward.localhost
STEWARD_TLS_HTTP_PORT=80
STEWARD_TLS_HTTPS_PORT=443

# Generated by `steward init`. The API/proxy receive only DATABASE_URL; the
# transient initialization chain owns the admin and migration URLs.
# Leave EMPTY here; do not commit real values.
POSTGRES_PASSWORD=
STEWARD_DB_APP_PASSWORD=
STEWARD_DB_MIGRATION_PASSWORD=
DATABASE_URL=
STEWARD_ADMIN_DATABASE_URL=
MIGRATION_DATABASE_URL=
# Explicit acknowledgement for the bundled Postgres connection, which stays on
# Compose's internal-only steward-data network. If DATABASE_URL points to an
# external database, use TLS and set this to false.
STEWARD_ALLOW_INSECURE_DB=true

# All secrets below are generated by `steward init`. Leave EMPTY here.
STEWARD_MASTER_PASSWORD=
STEWARD_JWT_SECRET=
STEWARD_KDF_SALT=
STEWARD_AUDIT_HMAC_KEY=

# Custody posture acknowledgement. This reference profile sets no
# STEWARD_KMS_PROVIDER, so the vault runs in `local` mode: keys are AES-256-GCM
# at rest but materialize as plaintext in the API process memory at sign time.
# In production the vault REFUSES TO BOOT in local mode unless this is set to
# `true` (a deliberate, auditable acknowledgement of the posture). The compose
# file defaults this to `true` for the reference stack; to run a stronger
# posture instead, set STEWARD_KMS_PROVIDER=aws|pkcs11 (+ its config) and set
# this to an empty value. See docs/security/custody-posture.md.
STEWARD_ACK_LOCAL_CUSTODY=true

# STEWARD_EXECUTION_AUTH_SECRET authorizes governed provider execution.
# Keep it separate from STEWARD_JWT_SECRET; it is never a fallback.
# Format: a comma-separated `keyId:secret` rotation list; the FIRST key
# signs, all listed keys verify for the token TTL window. Governed provider
# actions FAIL CLOSED if this is unset. Generate: printf 'v1:%s' "$(openssl rand -hex 32)"
STEWARD_EXECUTION_AUTH_SECRET=
STEWARD_AUDIT_SIGNING_KEY=
STEWARD_PLATFORM_KEY=
STEWARD_PLATFORM_KEYS=
STEWARD_PLATFORM_KEY_SCOPES=
STEWARD_PROXY_REQUEST_SIGNING_SECRETS=

RPC_URL=https://mainnet.base.org
CHAIN_ID=8453
APP_URL=https://steward.localhost
PASSKEY_RP_NAME=Steward
PASSKEY_RP_ID=steward.localhost
PASSKEY_ORIGIN=https://steward.localhost
# Provider-account X OAuth application credentials. These are distinct from
# Twitter/X human sign-in credentials.
X_CLIENT_ID=
X_CLIENT_SECRET=
