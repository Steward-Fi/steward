# Steward deployment configuration
# Copy to .env and fill in values

# Required — vault master encryption password
STEWARD_MASTER_PASSWORD=

# Required in production — canonical JWT signing and verification secret.
# Generate at least 32 random characters and keep it separate from the vault key.
STEWARD_JWT_SECRET=

# Required — tamper-evident audit-chain HMAC key. The api AND proxy services both
# extend the audit chain (proxy on approval expiry), and getHmacKey() fails
# closed in production if this is unset. Generate with: openssl rand -hex 32
STEWARD_AUDIT_HMAC_KEY=

# STEWARD_EXECUTION_AUTH_SECRET authorizes governed provider execution.
# Keep it separate from STEWARD_JWT_SECRET; it is never a fallback.
# Format: a comma-separated `keyId:secret` rotation list; the FIRST key
# signs, all listed keys verify for the token TTL window. Governed provider
# actions FAIL CLOSED if this is unset. Generate: printf 'v1:%s' "$(openssl rand -hex 32)"
STEWARD_EXECUTION_AUTH_SECRET=

# Database — leave empty to use local PostgreSQL container
# For Neon: postgresql://user:pass@ep-xxx.neon.tech/steward?sslmode=verify-full
DATABASE_URL=
# Legacy sslmode=require is rejected in production unless this explicit MITM-risk
# acknowledgement is true. Prefer verify-full and leave this unset.
# STEWARD_ALLOW_UNVERIFIED_DB_TLS=false

# Required when using the bundled Postgres container. Generate three distinct
# values; the API/proxy receive only the restricted app credential.
POSTGRES_PASSWORD=
STEWARD_DB_APP_PASSWORD=
STEWARD_DB_MIGRATION_PASSWORD=

# For external PostgreSQL, set the runtime URL above plus both operator URLs.
# STEWARD_ADMIN_DATABASE_URL=
# MIGRATION_DATABASE_URL=

# The bundled database is plaintext only on the isolated Compose network.
# Keep this false/unset when any URL points to an external database.
STEWARD_ALLOW_INSECURE_DB=true

# Redis — for rate limiting, spend tracking, policy caching
REDIS_URL=redis://localhost:6379

# EVM configuration
RPC_URL=https://mainnet.base.org
CHAIN_ID=8453

# Solana configuration
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional Monero-on-Solana bridge plugin. Add wxmr to an existing comma-
# separated list if other plugins are enabled.
# STEWARD_PLUGINS=wxmr
# WXMR_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Platform admin key — auto-generated if empty
STEWARD_PLATFORM_KEY=
# Provider-account X OAuth application credentials. These are distinct from
# TWITTER_CLIENT_ID/TWITTER_CLIENT_SECRET used for human sign-in.
X_CLIENT_ID=
X_CLIENT_SECRET=
