# Local workerd only. Copy to .dev.vars, which is ignored, and replace every
# external-service placeholder before running `bun run wrangler:dev`.
NODE_ENV=development
STEWARD_ALLOW_DEV_SECRETS=true
DATABASE_URL=postgres://USER:PASS@HOST/DB?sslmode=verify-full
STEWARD_APP_DATABASE_ROLE=steward_app
STEWARD_BOOTSTRAP_DATABASE_ROLE=steward_bootstrap_owner
STEWARD_MIGRATION_DATABASE_ROLE=steward_migrator
STEWARD_PLATFORM_DATABASE_URL=postgres://PLATFORM_USER:PASS@HOST/DB?sslmode=verify-full
STEWARD_PLATFORM_DATABASE_ROLE=steward_platform
KV_REST_API_URL=https://YOUR-DB.upstash.io
KV_REST_API_TOKEN=REPLACE_WITH_LOCAL_UPSTASH_TOKEN
STEWARD_MASTER_PASSWORD=local-worker-only-master-password
# Optional request-local bindings; defaults shown here match runtime defaults.
STEWARD_DEFAULT_TENANT_ID=default
STEWARD_NATIVE_PRICE_FALLBACK_USD=10000
APP_URL=http://localhost:8787
STEWARD_IDENTITY_JWT_ISSUER=http://localhost:8787
