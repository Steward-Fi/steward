{
  "name": "@stwd/api",
  "version": "0.4.4",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/lib.ts",
    "./app": "./src/app.ts",
    "./compose": "./src/compose.ts",
    "./plugin": "./src/plugin.ts"
  },
  "scripts": {
    "dev": "NODE_ENV=development bun --watch src/index.ts",
    "build": "tsc --noEmit",
    "migrate": "bun src/migrate.ts",
    "start": "bun src/index.ts",
    "migrate:production:core": "bun scripts/migrate-production.ts core",
    "migrate:production:plugins": "bun scripts/migrate-production.ts plugins",
    "openapi:generate": "bun scripts/generate-openapi.ts",
    "sdk:types": "bun scripts/generate-sdk-types.ts",
    "openapi": "bun scripts/generate-openapi.ts && bun scripts/generate-sdk-types.ts",
    "openapi:check": "bun run openapi && git diff --exit-code -- ../../docs/api-reference/openapi.json ../sdk/src/generated/api-types.ts",
    "test": "bun scripts/run-tests-isolated.ts",
    "test:single": "bun test --timeout 30000 src/__tests__/",
    "wrangler:dev": "wrangler dev",
    "wrangler:deploy": "wrangler deploy",
    "wrangler:dry-run": "wrangler deploy --dry-run --outdir=dist"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.700.0",
    "@node-saml/node-saml": "5.1.0",
    "@scure/btc-signer": "^2.2.0",
    "@stwd/adapters": "workspace:*",
    "@stwd/attestation": "workspace:*",
    "@stwd/auth": "workspace:*",
    "@stwd/db": "workspace:*",
    "@stwd/plugin-capabilities": "workspace:*",
    "@stwd/plugin-trading": "workspace:*",
    "@stwd/plugin-wxmr": "workspace:*",
    "@stwd/policy-engine": "workspace:*",
    "@stwd/provider-aws": "workspace:*",
    "@stwd/provider-github": "workspace:*",
    "@stwd/provider-slack": "workspace:*",
    "@stwd/provider-google": "workspace:*",
    "@stwd/provider-x": "workspace:*",
    "@stwd/redis": "workspace:*",
    "@stwd/shared": "workspace:*",
    "@stwd/vault": "workspace:*",
    "@stwd/webhooks": "workspace:*",
    "bs58": "^6.0.0",
    "drizzle-orm": "^0.45.2",
    "graphene-pk11": "^2.2.0",
    "hono": "^4.12.34",
    "jose": "^6.2.1",
    "siwe": "^3.0.0",
    "viem": "^2.30.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "@stwd/proxy": "workspace:*",
    "@stwd/sdk": "workspace:*",
    "@types/node": "^25.5.0",
    "openapi-typescript": "^7.13.0",
    "wrangler": "^4.0.0"
  },
  "description": "Hono REST API for Steward - agents, policies, approvals, and transaction signing"
}
