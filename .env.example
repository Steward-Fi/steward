# ─────────────────────────────────────────────────────────────────────────────
# Steward — Environment Variables
# Copy this file to .env and fill in the values.
#
#   cp .env.example .env
#
# Required variables are marked [REQUIRED]. Everything else has a default.
# ─────────────────────────────────────────────────────────────────────────────

# ─── API Server ───────────────────────────────────────────────────────────────

# Port the API listens on.
PORT=3200

# Host the API binds to. Use 0.0.0.0 to accept external connections (behind
# a reverse proxy). Default is 127.0.0.1 (loopback only).
STEWARD_BIND_HOST=127.0.0.1

# Steward API version string (informational, set by the codebase).
# API_VERSION=0.3.0

# ─── Security — Master Password ──────────────────────────────────────────────

# [REQUIRED] Master password used for deriving per-agent vault encryption keys
# (AES-256-GCM with scryptSync-derived keys). Use a long, random string.
# Rotating this requires re-encrypting all keys.
STEWARD_MASTER_PASSWORD=

# ─── Security — Custody posture acknowledgement ──────────────────────────────

# [REQUIRED in production when running local custody] When no STEWARD_KMS_PROVIDER
# is set, the vault runs in `local` mode: keys are AES-256-GCM at rest but are
# decrypted to plaintext in the API process memory at sign time. In production
# the vault REFUSES TO BOOT in local mode unless you explicitly acknowledge this
# posture by setting this to exactly "true" (a deliberate, auditable decision;
# mirrors the STEWARD_ALLOW_MOCK_ADAPTERS gate). To avoid needing the ack, run a
# stronger backend instead: STEWARD_KMS_PROVIDER=aws|pkcs11 (+ its config).
# See docs/security/custody-posture.md for the full threat model.
# STEWARD_ACK_LOCAL_CUSTODY=true

# Optional external signing custody. This is deliberately DISTINCT from
# STEWARD_KMS_PROVIDER=aws, which is envelope encryption and still decrypts
# wallet private keys in the Steward process. `aws-kms` stores only an opaque
# asymmetric key handle in Steward and asks an ECC_SECG_P256K1 SIGN_VERIFY KMS
# key to sign EVM transaction digests. The private key never enters Steward.
# See docs/security/external-custody.md.
# STEWARD_EXTERNAL_CUSTODY_PROVIDER=aws-kms
# STEWARD_EXTERNAL_CUSTODY_AWS_REGION=us-east-1
# Required fail-closed ceilings for RPC-prepared external-custody transactions.
# STEWARD_EXTERNAL_CUSTODY_AWS_MAX_GAS_LIMIT=1000000
# STEWARD_EXTERNAL_CUSTODY_AWS_MAX_GAS_PRICE_WEI=100000000000
# STEWARD_EXTERNAL_CUSTODY_AWS_MAX_TOTAL_FEE_WEI=100000000000000000

# [REQUIRED in production] Canonical JWT signing/verification secret used by
# the API, proxy, auth routes, user sessions, and agent-scoped tokens. Must be
# at least 32 characters in production. Existing deployments using
# STEWARD_SESSION_SECRET should rename that value to STEWARD_JWT_SECRET;
# STEWARD_SESSION_SECRET remains a deprecated compatibility fallback.
STEWARD_JWT_SECRET=
# Dedicated HMAC key for email login codes and cross-device polling. Use 32+ random bytes.
STEWARD_EMAIL_CODE_SECRET=

# Expiry for agent-scoped JWT tokens (e.g. "1h", "24h", "7d").
AGENT_TOKEN_EXPIRY=24h

# Opt-in escape hatch for insecure built-in "dev-secret" fallbacks (JWT signing,
# vault master password, email/oauth key store, webhook secret codec, test-account
# pepper). When secrets above are unset, these fallbacks are ONLY used if BOTH:
#   - NODE_ENV is not "production", AND
#   - STEWARD_ALLOW_DEV_SECRETS=true
# This prevents a staging/preview deploy that forgot NODE_ENV=production from
# silently running on predictable, well-known secrets. Leave UNSET in any shared
# or internet-reachable environment. Set to "true" only for local development.
# STEWARD_ALLOW_DEV_SECRETS=true

# [REQUIRED in production] HMAC key for the tamper-evident audit chain.
# Keep this distinct from STEWARD_JWT_SECRET and STEWARD_MASTER_PASSWORD —
# the audit chain's integrity guarantee depends on the key living in a
# different trust boundary than the database it audits.
# Generate with: openssl rand -hex 32
STEWARD_AUDIT_HMAC_KEY=
# Optional RFC 3161 anchoring for Ed25519 audit checkpoints. Default `off`
# performs no network request and does not add fields to evidence bundles.
# `best-effort` emits an unanchored bundle if the TSA is unavailable;
# `required` fails evidence generation closed instead.
# STEWARD_AUDIT_CHECKPOINT_ANCHOR_MODE=off
# STEWARD_AUDIT_CHECKPOINT_ANCHOR_PROVIDER=rfc3161
# STEWARD_AUDIT_RFC3161_URL=https://tsa.example.com/timestamp
# [REQUIRED when RFC 3161 is enabled] Local PEM trust anchor used to verify the
# CMS signer/path before Steward accepts or persists a token. Never sourced
# from the timestamp response.
# STEWARD_AUDIT_RFC3161_CA_FILE=/etc/steward/tsa-ca.pem
# STEWARD_AUDIT_RFC3161_UNTRUSTED_FILE=/etc/steward/tsa-intermediates.pem
# Optional exact signed TSTInfo policy allowlist (single OID).
# STEWARD_AUDIT_RFC3161_POLICY_OID=1.2.3.4.1
# Freshness bounds include the TSA's signed accuracy interval.
# STEWARD_AUDIT_RFC3161_MAX_AGE_SECONDS=300
# STEWARD_AUDIT_RFC3161_MAX_FUTURE_SKEW_SECONDS=300
# STEWARD_AUDIT_RFC3161_TIMEOUT_MS=10000

# [REQUIRED when creating or verifying retention archives] Stable identity for
# the active Ed25519 archive signing key. The active private key's public half
# must exactly match this id in the trusted registry; an embedded DB public key
# is never accepted as its own trust anchor.
# STEWARD_AUDIT_SIGNING_KEY=<64-hex seed or PKCS#8 PEM>
# STEWARD_AUDIT_SIGNING_KEY_ID=archive-signing-2026-01
# STEWARD_AUDIT_ARCHIVE_TRUSTED_SIGNING_KEYS={"archive-signing-2026-01":"-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"}

# Public keys for the independent immutable-storage service that signs archive
# durability acknowledgements. Steward does not hold the corresponding private
# key. No live audit event is pruned until one of these keys attests the exact
# manifest digest, immutable object URI, and object version.
# STEWARD_AUDIT_ARCHIVE_ACK_TRUSTED_KEYS={"archive-store-2026-01":"-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"}

# STEWARD_EXECUTION_AUTH_SECRET (PR4): key for provider execution
# authorization v2. SEPARATE from STEWARD_JWT_SECRET (never a fallback).
# Format: a comma-separated `keyId:secret` rotation list; the FIRST key
# signs, all listed keys verify for the token TTL window. Governed provider
# actions FAIL CLOSED if this is unset. Generate: printf 'v1:%s' "$(openssl rand -hex 32)"
STEWARD_EXECUTION_AUTH_SECRET=

# ─── Database ─────────────────────────────────────────────────────────────────

# [REQUIRED for full/Postgres mode] PostgreSQL connection string.
# Example: postgres://steward:password@localhost:5432/steward
DATABASE_URL=

# [REQUIRED when using the bundled Postgres container in docker-compose.yml]
# Password for the managed Postgres container. The production compose files
# require this to be set — there is no insecure default. Generate a strong
# value, e.g. openssl rand -hex 24. Also referenced by the default DATABASE_URL.
POSTGRES_PASSWORD=
# POSTGRES_USER=steward
# POSTGRES_DB=steward

# Database mode. Set to "pglite" to use the embedded PGLite backend instead
# of an external PostgreSQL server. Useful for local dev and desktop mode.
# When not set, DATABASE_URL is used.
# STEWARD_DB_MODE=pglite

# ─── PGLite (embedded / local mode) ──────────────────────────────────────────
# These only apply when STEWARD_DB_MODE=pglite or DATABASE_URL is unset.

# Directory where PGLite persists data. Default: ~/.steward/data
# STEWARD_PGLITE_PATH=~/.steward/data

# Set to "true" for in-memory PGLite (no persistence, useful for testing).
# STEWARD_PGLITE_MEMORY=false

# ─── Tenant & Platform Auth ───────────────────────────────────────────────────

# Default tenant API key (plaintext). Used when no X-Steward-Tenant header
# is present. Useful for single-tenant self-hosted deployments.
STEWARD_DEFAULT_TENANT_KEY=

# Platform operator keys (comma-separated). These keys authenticate requests
# to the /platform/* routes, which have cross-tenant admin access.
# Generate with: openssl rand -hex 32
STEWARD_PLATFORM_KEYS=

# ─── EVM / Blockchain ─────────────────────────────────────────────────────────

# Default RPC URL for EVM transactions and balance queries.
RPC_URL=https://sepolia.base.org

# Default chain ID (used when no chain is specified in a signing request).
# 84532 = Base Sepolia (testnet), 8453 = Base (mainnet)
CHAIN_ID=84532

# ─── Optional Plugins ─────────────────────────────────────────────────────────

# Comma-separated opt-in API plugins. Leave unset for the core API only.
# Enable the Monero-on-Solana bridge provider with "wxmr"; combine plugins as
# needed, for example: STEWARD_PLUGINS=trading,wxmr
# STEWARD_PLUGINS=wxmr

# Optional Solana mainnet RPC used by the wxmr plugin to verify the bridge's
# global and connected-wallet withdrawal fees. Remote endpoints must use HTTPS;
# plain HTTP is accepted only on loopback. Falls back to SOLANA_RPC_URL and then
# Solana's public mainnet endpoint.
# WXMR_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# ─── Monero (optional) ────────────────────────────────────────────────────────
# Monero support runs the official monero-wallet-rpc (wallet2) as a sidecar
# container against an explicitly configured TLS daemon — no bundled monerod
# or blockchain storage. Keys stay on this host: the encrypted spend/view keys in Postgres
# are canonical, sidecar wallet files are a disposable scan cache, and the
# configured daemon only ever sees block requests and fully-signed transactions.
#
# Enable with:  COMPOSE_PROFILES=monero docker compose up -d
# Leave STEWARD_MONERO_WALLET_RPC_URL empty to disable — all Monero endpoints
# then fail closed with 503.

# monero-wallet-rpc endpoint the API talks to (compose-internal address).
# STEWARD_MONERO_WALLET_RPC_URL=http://monero-wallet-rpc:18083/json_rpc
STEWARD_MONERO_WALLET_RPC_URL=

# [REQUIRED when the monero profile is enabled] Password for the sidecar's
# --rpc-login (username is "steward"). Generate with: openssl rand -hex 32
MONERO_WALLET_RPC_PASSWORD=

# [REQUIRED when the monero profile is enabled] Monero daemon. Use a daemon
# you trust and require TLS for remote hosts; plaintext public-daemon endpoints
# enable response tampering and metadata leaks.
# IMPORTANT (privacy): a public node operator can correlate your host's IP
# with wallet activity; run your own daemon or use Tor if that matters to you.
MONERO_DAEMON_ADDRESS=
STEWARD_MONERO_DAEMON_URL=

# Network the sidecar operates on: mainnet or stagenet.
STEWARD_MONERO_NETWORK=mainnet

# Fee ceiling for outgoing transfers, in piconero (default 0.1 XMR).
# STEWARD_MAX_MONERO_FEE_PICONERO=100000000000

# ─── Auth — Email (Magic Links) ───────────────────────────────────────────────

# Resend API key for sending magic link emails.
# If not set, magic link tokens are printed to the console (dev mode).
# Get one at https://resend.com
RESEND_API_KEY=

# From address for magic link emails.
EMAIL_FROM=login@localhost

# Base URL for magic link callbacks. Must be publicly accessible for email
# delivery; localhost is the safe self-host/dev default.
# The link in the email will be: APP_URL/auth/callback/email?token=...&email=...
APP_URL=http://localhost:3200

# ─── Auth — Passkeys (WebAuthn) ───────────────────────────────────────────────

# Relying Party name shown to users during passkey registration.
PASSKEY_RP_NAME=Steward

# Relying Party ID — must match the domain where the app is served.
PASSKEY_RP_ID=localhost

# Allowed origin for passkey operations. Must match the browser's origin.
PASSKEY_ORIGIN=http://localhost:3200

# ─── Auth — OAuth (Google, Discord, GitHub) ───────────────────────────────────

# Google OAuth (for "Continue with Google" login).
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Discord OAuth (for "Continue with Discord" login).
# Create app at https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# GitHub OAuth (for "Continue with GitHub" login).
# Create app at https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional comma-separated allowlist for SIWE/SIWS message domains.
# Example: SIWE_ALLOWED_DOMAINS=app.steward.fi,steward.fi
SIWE_ALLOWED_DOMAINS=

# Per-chain JSON-RPC endpoints for EIP-1271 smart-contract wallet logins
# (Safe, Argent, ...). Format: SIWE_RPC_<chainId>=https://...
# Example: SIWE_RPC_1=https://eth-mainnet.g.alchemy.com/v2/<key>
# In production there is NO fallback: without an override for the chain,
# contract-wallet logins on that chain fail closed ("no_rpc"). Outside
# production, hardcoded public RPCs (publicnode) are used as a convenience.
#SIWE_RPC_1=

# ─── Redis (optional) ─────────────────────────────────────────────────────────

# Redis connection URL. Required for:
#   - Rate limiting enforcement (per-IP request counts)
#   - Proxy spend tracking (LLM token usage per tenant)
#   - Tenant policy caching
#   - Durable agent-trader webhook replay protection across replicas
# If not set, rate limiting falls back to in-memory and spend tracking is disabled.
# Example: redis://localhost:6379
REDIS_URL=

# Production auth challenges, tokens, nonces, MFA state, and encrypted import
# sessions must use Redis or Postgres. Only for a guaranteed single-instance
# deployment, explicitly acknowledge process-local, restart-unsafe storage:
# STEWARD_ALLOW_MEMORY_AUTH_STORES=true

# Production agent-trader instances fail closed without shared replay storage.
# Upstash may be used instead via KV_REST_API_URL + KV_REST_API_TOKEN (or the
# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN aliases). Only for a
# guaranteed single-replica deployment, explicitly acknowledge process-local
# replay storage with:
# STEWARD_AGENT_TRADER_ACKNOWLEDGE_SINGLE_INSTANCE_REPLAY=true

# ─── Client IP trust (auth rate limiting) ─────────────────────────────────────

# Number of trusted reverse proxies that APPEND the observed client IP to
# x-forwarded-for before requests reach the API. REQUIRED on the Railway
# deploy: its edge appends exactly one entry, so set 1. Until it is set, auth
# rate limits fall back to coarse per-host buckets, which are weaker on a
# directly-exposed (non-Host-locked) service. The entry that many hops from
# the RIGHT is used as the per-client rate-limit subject. Set it to the EXACT
# number of appending proxies — overestimating re-opens IP spoofing.
# Unset/invalid = trust no forwarded headers (coarse per-host fallback; never
# a single global bucket, never open). Leave unset in un-proxied local dev.
# Bare Railway = 2: its edge adds two x-forwarded-for entries and the right-most
# one rotates between nodes, so the client is the 2nd from the right.
# STEWARD_TRUSTED_PROXY_HOPS=2

# Set to "true" ONLY when the API origin is locked behind Cloudflare; then
# cf-connecting-ip is preferred as the client IP. Leave unset otherwise — the
# header is client-forgeable when Cloudflare is not in front.
# STEWARD_TRUST_CLOUDFLARE=true

# DEPRECATED: legacy alias honored as STEWARD_TRUSTED_PROXY_HOPS=1 (right-most
# x-forwarded-for semantics) — INSUFFICIENT on bare Railway (needs 2). Prefer
# setting STEWARD_TRUSTED_PROXY_HOPS explicitly.
# STEWARD_TRUST_PROXY_HEADERS=true

# When Redis is CONFIGURED but unreachable in production, auth endpoints admit
# up to this many requests per minute per instance (bounded outage valve)
# before failing closed. Default 300; set 0 for strict fail-closed. Redis
# never configured in production always fails closed regardless.
# STEWARD_AUTH_RATE_LIMIT_OUTAGE_VALVE_MAX=300

# ─── Proxy ─────────────────────────────────────────────────────────────────────

# Port the proxy gateway listens on (default: 8080).
STEWARD_PROXY_PORT=8080

# ─── Migrations ───────────────────────────────────────────────────────────────

# Set to "true" to skip automatic migrations on API startup.
# Useful when running migrations separately via scripts/migrate.sh.
# SKIP_MIGRATIONS=false

# ─── Test-account token (DANGEROUS in production) ─────────────────────────────
# POST /test/token exchanges a tenant's test-account credentials for a real
# session token. It is hard-disabled in production unless this is "true".
# ⚠️ Enabling this in production lets anyone with the (often static) test
# email/phone/OTP obtain a valid session. Leave UNSET in prod; enable only for
# short, supervised app-review windows and disable immediately afterward.
# STEWARD_ENABLE_PROD_TEST_ACCOUNT_TOKEN=true

# ─── Auth — OAuth (Twitter / X) ───────────────────────────────────────────────

# Twitter/X OAuth (for "Continue with Twitter" LOGIN — the user sign-in plane).
# Create app at https://developer.x.com/en/portal/dashboard
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# ─── Provider-account X (Twitter) connect (#195 workstream A) ──────────────────
# SEPARATE from the TWITTER_CLIENT_ID login credentials above. These authorize a
# WORKSPACE to CONNECT an X account for governed AGENT ACTIONS (provider-
# connection plane), NOT human sign-in. Keep the two credential sets distinct so
# a login-app compromise cannot mint provider-action tokens (and vice versa).
# The connect flow uses OAuth 2.0 authorization-code + PKCE (S256) and requests
# the minimal scopes tweet.read tweet.write users.read offline.access.
# offline.access is REQUIRED to receive the rotating refresh token.
X_CLIENT_ID=
X_CLIENT_SECRET=

# ─── Web Dashboard (web/ — Next.js) ───────────────────────────────────────────
# These variables are used by the Next.js web app, not the API server.
# Prefix NEXT_PUBLIC_ variables are exposed to the browser bundle.

# URL of your Steward API instance.
NEXT_PUBLIC_STEWARD_API_URL=http://localhost:3200

# WalletConnect project ID for RainbowKit (SIWE wallet login).
# Get one at https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# URL of the Steward Proxy service. Use the compose-internal URL for the API
# container; browser/external clients can still reach http://localhost:8080.
STEWARD_PROXY_URL=http://steward-proxy:8080

# Shared HMAC root used by API invoke paths/clients to sign requests and by
# steward-proxy to verify them. Keep distinct from JWT/audit/master secrets.
# Generate with: openssl rand -hex 32
STEWARD_PROXY_REQUEST_SIGNING_SECRET=

# WARNING: allows secret routes to inject raw `Cookie`/`Set-Cookie` headers
# (whole-session replay, no revocation/rotation). Blocked by default; prefer a
# scoped broker read token via `Authorization: Bearer`. Only set if a target
# host speaks nothing but cookies.
# STEWARD_ALLOW_COOKIE_INJECTION=false

# API key for the Steward agent (used by the web app's server-side API routes).
STEWARD_AGENT_TOKEN=

# ─── Data Retention (SOC2 CC2) ────────────────────────────────────────────────
# A background sweep runs ~24h and deletes rows past their TTL from high-volume
# operational tables. Each table's TTL is independently overridable. All values
# are integers, in days.
#
# Set to "true" to fully disable the scheduler (intended for tests / one-shot
# tooling). Production deployments should leave this unset.
# STEWARD_RETENTION_DISABLED=false

# proxy_audit_log — per-request outbound credential-proxy log. High volume.
# Default: 90 days.
# STEWARD_RETENTION_PROXY_AUDIT_DAYS=90

# refresh_tokens — already enforce expires_at at issue time; this is a grace
# window after which expired rows are physically removed so the table doesn't
# grow unboundedly. Default: 7 days post-expiry.
# STEWARD_RETENTION_REFRESH_TOKEN_GRACE_DAYS=7

# transactions — only rows with status IN ('rejected','failed') are eligible
# for deletion. Signed / broadcast / confirmed transactions are kept
# indefinitely as a ledger record. Default: 365 days.
# STEWARD_RETENTION_FAILED_TX_DAYS=365

# audit_events — no destructive environment switch exists. Events are never
# deleted by default. An owner/admin with recent MFA must enable the tenant's
# retention policy through /audit/retention-policy; Steward then durably seals
# signed JSONL chunks before a separate transactional floor+delete step. See
# docs/security/audit-retention-archives.md.
